  "private": true,
  "description": "Backend API for the household dinner planner (recipes, weekly meal plan, shopping list).",
  "author": "Petter Franzen <petter.franzen@gmail.com>",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
